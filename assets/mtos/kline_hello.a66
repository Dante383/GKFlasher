; MTOS payload: proof of I/O. Sends "MTOS" over the K-line, then returns.
; payload_kline_hello() in flasher/mtos_asm.py, run by --mtos-mode hello.
; See docs/mtos.md.
; FAST=1 adds the MT75/ACK baud handshake and restores the UART on return.
;
; The K-line is the ASC0 UART. To send a byte, write it to S0TBUF, wait
; until the UART sets S0TIR (it has taken the byte), then clear S0TIR.

$MOD167
$INCLUDE (REG167.INC)
FAST EQU 0
ENTRY_RELOAD EQU 71            ; 10400-baud handshake on the 24 MHz platform
BAUD_RELOAD EQU 5              ; selected transfer rate, default 125000 baud

MTOS    SECTION CODE AT 0C014H
Main    PROC    FAR
IF FAST
        PUSH R1
        PUSH R2
        PUSH R3
        PUSH S0TIC
        PUSH S0RIC
        PUSH S0BG
        PUSH S0CON
        CALLS SEG FastStart,SOF FastStart
        CMP R2,#0
        JMPA cc_EQ,Restore
ENDIF
        BCLR    S0TIE           ; no transmit interrupt: we poll the UART
        MOVB    S0TBUF, #'M'
Tx1:    JNB     S0TIR, Tx1
        BCLR    S0TIR
        MOVB    S0TBUF, #'T'
Tx2:    JNB     S0TIR, Tx2
        BCLR    S0TIR
        MOVB    S0TBUF, #'O'
Tx3:    JNB     S0TIR, Tx3
        BCLR    S0TIR
        MOVB    S0TBUF, #'S'
Tx4:    JNB     S0TIR, Tx4
        BCLR    S0TIR
        ; S0TIR only means the UART has started on the byte. Once it takes
        ; this dummy byte, the 'S' has gone out completely.
        MOVB    S0TBUF, #0
Tx5:    JNB     S0TIR, Tx5
        BCLR    S0TIR
IF FAST
        MOVB RL1,#0
        CALLS SEG FastEcho,SOF FastEcho
Restore:
        POP S0CON
        POP S0BG
        POP S0RIC
        POP S0TIC
        POP R3
        POP R2
        POP R1
ELSE
        BSET    S0TIE           ; give the UART back to the firmware
ENDIF
        RET
Main    ENDP
IF FAST
$INCLUDE (fast_link.inc)
ENDIF
MTOS    ENDS
        END
