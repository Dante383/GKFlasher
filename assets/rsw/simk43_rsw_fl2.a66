; Fixed-layout region descriptors used by the native address parser.
RSW_RegionTable:
    DB 002H,000H,002H,001H,083H,008H,002H,001H,004H,009H,002H,004H
    DB 004H,00AH,002H,002H,004H,00BH,002H,002H,004H,00CH,002H,002H
    DB 004H,00DH,002H,002H,004H,00EH,002H,002H,004H,00FH,002H,002H
RSW_PayloadEnd:
RSW_ValidationStatusScratch:
    DB 0FFH
RSWImage ENDS

; The original image ends at 0x87FFE (inclusive).
; Gaps between sections are emitted as erased 0xFF bytes by the build.
RSWExtent SECTION CODE AT 087FFEH
    DB 0FFH
RSWExtent ENDS
END
