; Recognize action-service 0xC311 and enter the software-reset path.
RSW_HandleResetService:
    MOVB RL4,byte_C0FC
    CMPB RL4,#DATA16 21H
    JMPR cc_NZ,locret_826F6
    MOVBZ R4,byte_C0FF
    SHL R4,#8
    MOVBZ R5,byte_C0FE
