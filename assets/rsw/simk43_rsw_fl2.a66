; SIMK43 RSW recovery loader.
; Preserves its CAN/CCP protocol, fixed entry points, AMD flash operations
; and region table.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)

; Original absolute RAM/SFR state references; preserve their access modes.
word_3EEC                EQU 03EECH
word_3EEE                EQU 03EEEH
word_3EF0                EQU 03EF0H
word_3EF2                EQU 03EF2H
word_3FE6                EQU 03FE6H
byte_C0FC                EQU 0C0FCH
byte_C0FD                EQU 0C0FDH
byte_C0FE                EQU 0C0FEH
byte_C0FF                EQU 0C0FFH
byte_C100                EQU 0C100H
