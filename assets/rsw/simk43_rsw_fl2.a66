word_C12A                EQU 0C12AH
byte_C12C                EQU 0C12CH
byte_C12D                EQU 0C12DH
word_C12E                EQU 0C12EH
word_C130                EQU 0C130H
byte_C132                EQU 0C132H
word_C134                EQU 0C134H
word_C136                EQU 0C136H
word_C138                EQU 0C138H
word_C13A                EQU 0C13AH
word_EE00                EQU 0EE00H
byte_EE02                EQU 0EE02H
word_FD64                DEFA 0FD64H
word_FE52                DEFR 0FE52H
word_FE56                DEFR 0FE56H
word_FEA0                DEFR 0FEA0H
word_FF50                DEFR 0FF50H
word_FF9E                DEFR 0FF9EH
word_FFA0                DEFR 0FFA0H

RSWImage SECTION CODE AT 082000H
RSW_Header:
    DW 02293H,1             ; original loader header words
    DD RSW_Entry_CAN,RSW_PayloadEnd-1
    DB '111663606621'       ; original twelve-byte identification


; Native CAN entry: configure RAM/peripherals, then service CCP requests.
RSW_Entry_CAN:
    MOV [-R0],R12
    BCLR IEN
    MOV word_FE56,#DATA16 0
    MOV word_FF9E,#DATA16 0
    AND word_FF50,#DATA16 0FFH
    OR word_FF50,#DATA16 4400H
    MOV word_C128,word_FE52
    MOV R4,#5
    MOV word_C12A,R4
    MOV DPP0,#DATA16 24H
    MOV DPP1,#DATA16 28H
    MOV DPP2,#DATA16 25H
    MOV ADDRSEL1,#DATA16 1008H
    CALLS 8,SOF RSW_CAN_Init
    MOVB RL4,[R0]
    MOVBZ R12,RL4
    CALLS 8,SOF RSW_Init_ResponseState
    MOV word_C122,ONES
    MOV R4,#8
    MOV word_C126,R4
    MOV word_FFA0,#DATA16 81H
    BSET word_FFA0.7
    MOV word_C120,ZEROS
    MOV word_C112,ZEROS
    MOV word_C114,ZEROS
    CALLS 8,SOF RSW_ClearPageBuffer
loc_82072:
    MOV R4,word_FE52
    SUB R4,word_C128
    CMP R4,#DATA16 0BBH
    JMPR cc_ULE,loc_82090
    MOV R4,#DATA16 0BBH
    ADD word_C128,R4
    CALLS 8,SOF RSW_PollSupplyVoltage
    ADD word_C12A,ONES
loc_82090:
    MOV R4,word_C12A
    JMPA cc_NZ,SOF loc_820CE
    MOV R5,#5
    MOV word_C12A,R5
    MOV WDTCON,#DATA16 0EA01H
    SRVWDT
    MOV R4,word_C122
    CMP R4,#DATA16 0C4H
    JMPA cc_NC,SOF loc_820CE
    JMPR cc_UC,loc_820C0
loc_820B4:
    MOV WDTCON,#DATA16 0EA01H
    SRVWDT
    CALLS 8,SOF RSW_PollSupplyVoltage
loc_820C0:
    MOV R4,word_C122
    CMP R4,#DATA16 0C4H
    JMPR cc_C,loc_820B4
    SRST
loc_820CE:
    EXTR #1
    JB XP1IR,loc_820D8
    JMPA cc_UC,SOF loc_82072
loc_820D8:
    EXTR #1
    JB XP1IE,loc_820E2
    JMPA cc_UC,SOF loc_82072
loc_820E2:
    EXTR #1
    BCLR XP1IR
    CALLS 8,SOF RSW_CAN_ReceiveInterrupt
    JMPA cc_UC,SOF loc_82072
    RETS

; Configure the CAN message objects used by the native recovery protocol.
RSW_CAN_Init:
    MOV [-R0],R6
    MOV R13,#DATA16 0EE00H
    MOV R4,#DATA16 74BH
    MOV [R13],R4
    MOV R13,#DATA16 0EE04H
    MOV R4,#DATA16 3601H
    MOV [R13],R4
    MOV R13,#DATA16 0EE06H
    MOV R4,#DATA16 0FFFFH
    MOV [R13],R4
    MOV R13,#DATA16 0EE08H
    MOV [R13],R4
    MOV R13,#DATA16 0EE0AH
    MOV [R13],R4
    MOV R12,#DATA16 0EE10H
    MOV R4,#DATA16 5595H
    MOV [R12],R4
    MOV R4,#DATA16 20D4H
    MOV [R12+#2],R4
    MOV R4,#0
    MOV [R12+#4],R4
    MOVB RL4,#8
    MOVB [R12+#6],RL4
    ADD R12,#DATA16 10H
    MOV R4,#DATA16 5599H
    MOV [R12],R4
    MOV R4,#DATA16 0D4H
    MOV [R12+#2],R4
    MOV R4,#0
    MOV [R12+#4],R4
    MOVB RL4,#0
    MOVB [R12+#6],RL4
    ADD R12,#DATA16 10H
    MOVB RL6,#3
loc_8215E:
    MOV R4,#DATA16 5555H
    MOV [R12],R4
    ADDB RL6,#1
    ADD R12,#DATA16 10H
    CMPB RL6,#DATA16 0FH
    JMPR cc_ULE,loc_8215E
    MOV R13,#DATA16 0EE00H
    MOV R4,[R13]
    AND R4,#DATA16 0FFFEH
    MOV [R13],R4
    EXTR #2
    MOV XP1IC,#DATA16 9
    BSET XP1IE
    MOVB byte_C0FC,ZEROS
    MOVB byte_C110,ZEROS
    MOV R6,[R0+]
    RETS

; Initialize the response buffer and recovery-loader state.
RSW_Init_ResponseState:
    MOV [-R0],R12
    EXTP #DATA16 20H,#DATA16 1
    MOVB RSW_ValidationStatusScratch,ZEROS
    MOV R4,#DATA16 30ACH
    MOV R5,#DATA16 8
    MOV word_C134,R4
    MOV word_C136,R5
    MOVB RL4,#1
    MOVB byte_C109,RL4
    MOVB RL5,#DATA16 0D2H
    MOVB byte_C10A,RL5
    MOVB RL3,#5
    MOVB byte_C10E,RL3
    MOVB byte_C106,ONES
    MOVB byte_C107,ZEROS
    MOV R2,R12
    MOVB byte_C108,RL2
    CALLS 8,SOF RSW_CAN_SendCRM
    ADD R0,#2
    RETS

; Capture an incoming CAN command and update its pending state.
RSW_CAN_ReceiveInterrupt:
    MOV [-R0],R9
    MOV [-R0],R7
    MOV [-R0],R6
    JMPR cc_UC,loc_82258
loc_821DC:
    CMPB RL6,#1
    JMPR cc_NZ,loc_8220A
    MOV R4,word_EE00
    AND R4,#DATA16 8000H
    BMOVN USR0,Z
    JNB USR0,loc_821F4
    MOVB RL7,#1
    JMPR cc_UC,loc_821F6
loc_821F4:
    MOVB RL7,#0
loc_821F6:
    CMPB RL7,byte_C110
    JMPR cc_Z,loc_82258
    MOVB byte_C110,RL7
    MOVB RL4,RL7
    JMPR cc_Z,loc_82258
    CALLS 8,SOF RSW_CAN_Init
    JMPR cc_UC,loc_82258
loc_8220A:
    SUBB RL6,#3
    MOV R9,#DATA16 0EE10H
    MOVBZ R4,RL6
    SHL R4,#4
    ADD R9,R4
    MOV R4,#DATA16 0FFFDH
    MOV [R9],R4
    MOVB RL4,[R9+#6]
    MOVBZ R4,RL4
    AND R4,#DATA16 8
    JMPR cc_Z,loc_82232
    CALLS 8,SOF RSW_CAN_TxControlA
    CALLS 8,SOF RSW_HandleResetService
    JMPR cc_UC,loc_82258
loc_82232:
    MOV R9,#DATA16 0EE20H
    MOVB RL4,[R9+#6]
    MOVBZ R4,RL4
    AND R4,#DATA16 0F0H
    ASHR R4,#4
    MOVB byte_C104,RL4
    MOV R12,#DATA16 0C0FCH
    MOV R13,R9
    ADD R13,#7
    MOVBZ R14,RL4
    CALLS 8,SOF RSW_CopyBytes
    CALLS 8,SOF RSW_Dispatch_CCP
loc_82258:
    MOVB RL4,byte_EE02
    MOVB RL6,RL4
    CMPB RL4,#0
    JMPR cc_NZ,loc_821DC
    MOV R6,[R0+]
    MOV R7,[R0+]
    MOV R9,[R0+]
    RETS

; Publish the eight-byte CCP response using the CAN transmit object.
RSW_CAN_SendCRM:
    MOV [-R0],R9
    MOV R9,#DATA16 0EE10H
    MOV R4,#DATA16 0FAFFH
    MOV [R9],R4
    MOV R12,R9
    ADD R12,#7
    MOV R13,#DATA16 0C106H
    MOVBZ R14,byte_C10E
    CALLS 8,SOF RSW_CopyBytes
    MOV R4,R9
    ADD R4,#6
    MOVB RL5,[R4]
    ANDB RL5,#DATA16 0FH
    MOVB [R4],RL5
    MOVBZ R4,byte_C10E
    SHL R4,#4
    ANDB RL4,#DATA16 0F0H
    MOV R5,R9
    ADD R5,#6
    MOVB RL3,[R5]
    ORB RL3,RL4
    MOVB [R5],RL3
    MOV R4,#DATA16 0E7FFH
    MOV [R9],R4
    MOV R9,[R0+]
    RETS

; Apply the original CAN transmit-control masks (0xFF7F/0xFFDF/0xFFBF).
RSW_CAN_TxControlA:
    MOV R12,#DATA16 0EE10H
    MOV R4,#DATA16 0FF7FH
    MOV [R12],R4
    MOV R4,#DATA16 0FFDFH
    MOV [R12],R4
    MOV R4,#DATA16 0FFBFH
    MOV [R12],R4
    RETS

; Apply the alternate transmit-control masks (0xFF7F/0xFFEF/0xFFBF).
RSW_CAN_TxControlB:
    MOV R12,#DATA16 0EE10H
    MOV R4,#DATA16 0FF7FH
    MOV [R12],R4
    MOV R4,#DATA16 0FFEFH
    MOV [R12],R4
    MOV R4,#DATA16 0FFBFH
    MOV [R12],R4
    RETS

; Copy R14 bytes from R13 to R12; pointers advance byte by byte.
RSW_CopyBytes:
    JMPR cc_UC,loc_822E6
loc_822E2:
    MOVB [R12],[R13+]
    ADD R12,#1
loc_822E6:
    CMPD1 R14,#0
    JMPR cc_NZ,loc_822E2
    RETS

